{
  "version": 3,
  "howToSwap": [
    "1. Put the client's photo in public/client-photos/<id>.jpg (same id as the stand-in it replaces).",
    "2. Either drop a ready-made transparent cutout at public/client-photos/cutouts/<id>.png (Photoroom / remove.bg), or leave 'mask' as 'model' and run the background remover.",
    "3. In this file set the asset's \"status\" to \"client\", \"source\" to the new file, clear \"polygon\" / \"retouch\" / \"screen\" if they no longer apply.",
    "4. Run: npm run prepare-cutouts  → writes public/products/<id>-cut.png. Every page reads the image path from here, so nothing else changes."
  ],
  "artDirection": {
    "basis": "Studied from the Pinterest saves in ../images (reference only — never used, cropped or traced).",
    "light": "Soft high-key key light from upper front-left, gentle fall-off to lower right. Bright, even, no hard shadows on the product body. Displays glow softly. Our Stage reproduces this with a top radial highlight; every cutout is graded to the same neutral white point so stainless reads cool-silver and white bodies read clean, never blue or yellow.",
    "angles": {
      "cooling": "Indoor unit seen slightly from below, 3/4 with the LEFT side panel visible (mirror a shot if needed). Louvres closed or barely open. No painted airflow effects.",
      "refrigeration": "Straight-on, full height, doors closed, chest height. Handles vertical. No open doors, no food.",
      "home-appliances": "Straight-on or very slight 3/4, product centred, controls readable.",
      "electronics": "Straight-on, screen square to camera. Screens show a calm Bordeaux gradient, never a busy UI or someone else's content.",
      "mobility": "Side or 3/4 profile, wheels on the floor line, facing right."
    },
    "colour": "Neutral greys, warm porcelain and cool stainless. Accent warmth from the Bordeaux / Cherry palette, never from the product photo. Avoid AI neon purples, teal casts and orange kitchen light.",
    "composition": "One product per frame. Product fills 72–80% of the stage height, centred, sitting on a soft floor shadow, generous negative space above for the headline. Same scale for every product inside a category.",
    "avoid": [
      "open doors full of food",
      "people or hands",
      "rooms and kitchens behind the product",
      "readable third-party logos",
      "watermarks",
      "painted airflow streaks",
      "AI-generated products"
    ]
  },
